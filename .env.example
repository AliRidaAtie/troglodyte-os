# Copy to .env and fill in. Never commit .env, never share it.

# https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Sophisticated Troglodytes. Makes slash commands appear instantly.
GUILD_ID=338649070904016898

# The assembly channel. Cave events, the daily thread and museum inductions post here.
EVENT_CHANNEL_ID=1542511652384145469
MUSEUM_CHANNEL_ID=1542511652384145469

# Powers /newspaper, /trivia, /sophisticate and the roasts.
# Free key from https://aistudio.google.com/apikey
# You can list several keys separated by commas. If one is rate limited or
# the model is busy, the bot walks down the list and keeps going.
GEMINI_API_KEY=

# Leave blank. The bot asks Google which models the key can reach and picks one.
GEMINI_MODEL=
